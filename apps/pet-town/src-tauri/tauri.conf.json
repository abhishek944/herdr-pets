{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pet Town",
  "version": "1.2.9",
  "identifier": "dev.pet.town",
  "build": {
    "beforeDevCommand": "pnpm run internal:dev-frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run internal:build-frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNzQ2NDU5NjZFRjk3NQpSV1IxK1c2V1JVWVhDL0ppdDc1ZmNjdzBiS2hYKytSNXl0a2RuK0hHdHA3TVhRdDN4TE9XNWNrYQo=",
      "endpoints": ["https://github.com/abhishek944/pet-town/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "resources": ["resources"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
