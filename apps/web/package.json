{
  "name": "@pet-town/web",
  "private": true,
  "version": "1.2.10",
  "description": "Pet Town landing page",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pet-town/three-town build:public && vite",
